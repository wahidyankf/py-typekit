#!/usr/bin/env bash
# The same ordered registry `repo-config.yml` declares, dispatched rather than
# transcribed. A hook that restates the order is a second copy of it, and the
# two drift the first time a gate is added to one and not the other.
# The pre-commit surface holds only the work its allowed list in `repo-config.yml` names.
set -euo pipefail
root=$(git rev-parse --show-toplevel)
export PATH="$root/node_modules/.bin:$PATH"

exec ./rhino gate run --surface pre-commit
